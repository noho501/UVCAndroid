<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="160dp"
    android:layout_height="90dp"
    android:layout_margin="6dp"
    android:background="@drawable/bg_multi_slot">

    <com.serenegiant.widget.AspectRatioSurfaceView
        android:id="@+id/uvcPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Opaque, so it covers the SurfaceView while there is no picture to show -->
    <LinearLayout
        android:id="@+id/uvcPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_multi_slot"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="16dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_videocam"
            app:tint="@color/multi_icon" />

        <TextView
            android:id="@+id/uvcPlaceholderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/multi_text_secondary"
            android:textSize="11sp"
            tools:text="@string/multi_camera_slot_empty" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="4dp"
        android:background="@drawable/bg_multi_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp">

        <View
            android:id="@+id/uvcStatusDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_multi_dot" />

        <TextView
            android:id="@+id/uvcLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="CAM 1" />
    </LinearLayout>

    <View
        android:id="@+id/uvcRedBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_red_border"
        android:visibility="gone" />
</FrameLayout>
